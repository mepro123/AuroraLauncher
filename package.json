{
  "name": "offlinecraft",
  "version": "2.0.0",
  "main": "main.js",
  "description": "OfflineCraft - offline Minecraft launcher",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.1"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . OfflineCraft --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite --ignore=^/test --ignore=^/dist && node build/finish.js"
  }
}